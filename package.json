{
  "name": "custom-hosts-optimizer",
  "version": "2.0.0",
  "description": "自定义域名访问加速，智能 IP 优选解决访问慢的问题",
  "keywords": [
    "hosts",
    "dns",
    "cloudflare-workers",
    "ip-optimization",
    "github-hosts",
    "custom-domains"
  ],
  "homepage": "https://github.com/violin321/custom-hosts-optimizer",
  "repository": {
    "type": "git",
    "url": "https://github.com/violin321/custom-hosts-optimizer.git"
  },
  "author": "Yan-nian",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
